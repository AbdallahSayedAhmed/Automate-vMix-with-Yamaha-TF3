{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "start": "concurrently \"npm run dev\" \"electron .\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:build": "electron-builder build --win"
  },
  "build": {
    "appId": "com.vmixyamahabridge.app",
    "productName": "vMix-Yamaha Bridge",
    "directories": {
      "output": "dist_electron"
    },
    "asar": false,
    "win": {
      "target": "dir",
      "icon": "public/program-image.ico"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend.exe",
        "to": "../backend.exe"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^1.8.10",
    "sonner": "^2.0.7",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
